# 复制为 application-prod.yml 并填写真实密码（该文件勿提交 Git）
#   copy deploy\config\application-prod.yml.example deploy\config\application-prod.yml
# 部署路径：E:\SOFTWARE\gzhennaxia\config\application-prod.yml

server:
  port: 9527

spring:
  datasource:
    driver-class-name: org.postgresql.Driver
    url: jdbc:postgresql://127.0.0.1:5432/gzhennaxia
    username: postgres
    password: 你的数据库密码

  sql:
    init:
      mode: never

  cache:
    type: caffeine
    caffeine:
      spec: maximumSize=1000,expireAfterWrite=30m

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

logging:
  file:
    name: E:/SOFTWARE/gzhennaxia/logs/backend.log
  level:
    root: INFO
    org.springframework: WARN
